generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String?
  image         String?
  emailVerified DateTime?
  salt          String?   // E2E encryption salt (base64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspaces     WorkspaceMember[]
  notes          Note[]
  todoLists      TodoList[]
  ownedWorkspaces Workspace[]
  documentLocks DocumentLock[]
}

model Workspace {
  id          String   @id @default(cuid())
  title       String
  description String?
  color       String   @default("#6366f1")
  icon        String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User              @relation(fields: [ownerId], references: [id])
  members    WorkspaceMember[]
  notes      Note[]
  todoLists  TodoList[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("member") // "owner" | "member" | "viewer"
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Note {
  id          String   @id @default(cuid())
  title       String
  content     String   @default("") // MDX/JSON content
  workspaceId String?
  authorId    String
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User      @relation(fields: [authorId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  locks     DocumentLock[]
}

model TodoList {
  id          String   @id @default(cuid())
  title       String
  workspaceId String?
  authorId    String
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User      @relation(fields: [authorId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  items     TodoItem[]
  locks     DocumentLock[]
}

model TodoItem {
  id         String   @id @default(cuid())
  title      String
  completed  Boolean  @default(false)
  order      Int      @default(0)
  todoListId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  todoList TodoList @relation(fields: [todoListId], references: [id], onDelete: Cascade)
}

model DocumentLock {
  id          String   @id @default(cuid())
  documentType String  // "note" | "todolist"
  documentId   String
  userId       String
  lockedAt     DateTime @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id])
  note Note? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  todoList TodoList? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentType, documentId])
}
