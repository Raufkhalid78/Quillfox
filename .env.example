# ---------------------------------------------------------------------------
# QuillFox web — environment configuration
# Copy to .env.local and fill in real values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Bypasses RLS — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.0.0

# Safepay payments (required for billing)
# Safepay issues TWO keys per account (Dashboard → Developers → API):
#   - API key    = public/publishable key  → SAFEPAY_API_KEY
#   - Secret key = private key (v1 secret) → SAFEPAY_V1_SECRET
# Do not swap them.
SAFEPAY_ENVIRONMENT=production
SAFEPAY_API_KEY=your_safepay_public_api_key
SAFEPAY_V1_SECRET=your_safepay_secret_key
# Webhook signing secret (Dashboard → Developers → Webhooks)
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret
# Optional: only needed if your Safepay webhook payloads include plan ids
SAFEPAY_PLAN_PREMIUM_ID=your_premium_plan_id
SAFEPAY_PLAN_ULTRA_ID=your_ultra_plan_id

# Sentry (optional — monitoring disabled when DSN is unset)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Build/upload only. Keep these server-side.
SENTRY_ORG=quillfox
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=

# Content-Security-Policy violation reporting endpoint (optional)
CSP_REPORT_URI=